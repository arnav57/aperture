-/*
- * Synchronizes an active-high asynchronous reset signal to a given clock by
- * using a pipeline of N registers.
- */
-module sync_reset #
-(
-    // depth of synchronizer
-    parameter N = 2
-)
-(
-    input  wire clk,
-    input  wire rst,
-    output wire out
-);
