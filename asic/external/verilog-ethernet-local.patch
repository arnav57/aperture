-// Internal 125 MHz clock
-wire clk_125mhz_mmcm_out;
-wire clk_125mhz_int;
-wire rst_125mhz_int;
-
-wire mmcm_rst = reset;
-wire mmcm_locked;
-wire mmcm_clkfb;
