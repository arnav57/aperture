-                delay_next = prescale;
-                phy_state_next = PHY_STATE_READ_BIT_3;
-            end
-            PHY_STATE_READ_BIT_3: begin
-                // read bit
-                //      ________
-                // sda X________X
-                //        ____
-                // scl __/    \__
-
-                scl_o_next = 1'b0;
-                delay_next = prescale;
-                phy_state_next = PHY_STATE_READ_BIT_4;
-            end
-            PHY_STATE_READ_BIT_4: begin
-                // read bit
-                //      ________
-                // sda X________X
-                //        ____
-                // scl __/    \__
-
-                phy_state_next = PHY_STATE_ACTIVE;
-            end
-            PHY_STATE_STOP_1: begin
-                // stop bit
-                //                 ___
-                // sda XXX\_______/
-                //             _______
-                // scl _______/
-
-                scl_o_next = 1'b1;
-                delay_scl_next = 1'b1;
-                delay_next = prescale;
-                phy_state_next = PHY_STATE_STOP_2;
-            end
-            PHY_STATE_STOP_2: begin
-                // stop bit
-                //                 ___
-                // sda XXX\_______/
-                //             _______
-                // scl _______/
-
-                sda_o_next = 1'b1;
-                delay_next = prescale;
-                phy_state_next = PHY_STATE_STOP_3;
-            end
-            PHY_STATE_STOP_3: begin
-                // stop bit
-                //                 ___
-                // sda XXX\_______/
-                //             _______
-                // scl _______/
-
-                bus_control_next = 1'b0;
-                phy_state_next = PHY_STATE_IDLE;
-            end
-        endcase
-    end
-end
-
-always @(posedge clk) begin
-    if (rst) begin
-        state_reg <= STATE_IDLE;
-        phy_state_reg <= PHY_STATE_IDLE;
-        delay_reg <= 16'd0;
-        delay_scl_reg <= 1'b0;
-        delay_sda_reg <= 1'b0;
-        cmd_ready_reg <= 1'b0;
-        data_in_ready_reg <= 1'b0;
-        data_out_valid_reg <= 1'b0;
-        scl_o_reg <= 1'b1;
-        sda_o_reg <= 1'b1;
-        busy_reg <= 1'b0;
