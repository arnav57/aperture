-// Place first payload byte onto LEDs
-reg valid_last = 0;
-reg [7:0] led_reg = 0;
-
-always @(posedge clk_125mhz) begin
-    if (rst_125mhz) begin
-        led_reg <= 0;
-    end else begin
-        if (tx_udp_payload_axis_tvalid) begin
-            if (!valid_last) begin
-                led_reg <= tx_udp_payload_axis_tdata;
-                valid_last <= 1'b1;
-            end
-            if (tx_udp_payload_axis_tlast) begin
-                valid_last <= 1'b0;
-            end
-        end
-    end
-end
