-
-ifdef XDC_FILES
-  XDC_FILES_REL = $(foreach p,$(XDC_FILES),$(if $(filter /% ./%,$p),$p,../$p))
-else
-  XDC_FILES_REL = $(PROJECT).xdc
-endif
-
-###################################################################
-# Main Targets
-#
-# all: build everything
-# clean: remove output files and project files
-###################################################################
-
-all: fpga
