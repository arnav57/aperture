-
-###################################################################
-# Target implementations
-###################################################################
-
-# Vivado project file
-create_project.tcl: Makefile $(XCI_FILES_REL) $(IP_TCL_FILES_REL)
-	rm -rf defines.v
-	touch defines.v
-	for x in $(DEFS); do echo '`define' $$x >> defines.v; done
-	echo "create_project -force -part $(FPGA_PART) $(PROJECT)" > $@
