-dict set xcvr_config CONFIG.RX_LINE_RATE $eth_xcvr_line_rate
-dict set xcvr_config CONFIG.RX_QPLL_FRACN_NUMERATOR $eth_xcvr_qpll_fracn
-dict set xcvr_config CONFIG.RX_REFCLK_FREQUENCY $eth_xcvr_refclk_freq
