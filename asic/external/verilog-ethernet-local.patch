-    input  wire                             clk,
-    input  wire                             rst,
-
-    /*
-     * AXI Stream inputs
-     */
-    input  wire [S_COUNT*S_DATA_WIDTH-1:0]  s_axis_tdata,
-    input  wire [S_COUNT*S_KEEP_WIDTH-1:0]  s_axis_tkeep,
-    input  wire [S_COUNT-1:0]               s_axis_tvalid,
