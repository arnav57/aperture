-// Place first payload byte onto LEDs
-reg valid_last = 0;
-reg [7:0] led_reg = 0;
-
-always @(posedge clk) begin
-    if (rst) begin
-        led_reg <= 0;
-    end else begin
-        valid_last <= tx_udp_payload_axis_tvalid;
-        if (tx_udp_payload_axis_tvalid & ~valid_last) begin
-            led_reg <= tx_udp_payload_axis_tdata;
-        end
-    end
-end
-
-assign led = led_reg;
