-localparam [3:0]
-    STATE_IDLE = 3'd0,
-    STATE_RUN = 3'd1,
-    STATE_TABLE_1 = 3'd2,
-    STATE_TABLE_2 = 3'd3,
-    STATE_TABLE_3 = 3'd4;
-
-reg [4:0] state_reg = STATE_IDLE, state_next;
-
