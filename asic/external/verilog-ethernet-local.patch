-     * I2C interface
-     */
-    input  wire        scl_i,
-    output wire        scl_o,
-    output wire        scl_t,
-    input  wire        sda_i,
-    output wire        sda_o,
-    output wire        sda_t,
-
-    /*
-     * Status
-     */
-    output wire        busy,
-    output wire        bus_control,
-    output wire        bus_active,
-    output wire        missed_ack,
-
-    /*
-     * Configuration
