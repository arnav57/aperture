-	echo "open_project $(PROJECT).xpr" > generate_bit.tcl
-	echo "open_run impl_1" >> generate_bit.tcl
-	echo "write_bitstream -force $(PROJECT).runs/impl_1/$(PROJECT).bit" >> generate_bit.tcl
