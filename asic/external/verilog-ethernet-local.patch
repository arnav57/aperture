-                // sda    \_______
-                //     _______
-                // scl        \___
-                //
-
-                scl_o_next = 1'b0;
-                delay_next = prescale;
-                phy_state_next = PHY_STATE_START_2;
-            end
-            PHY_STATE_START_2: begin
-                // generate start bit
-                //     ___
-                // sda    \_______
-                //     _______
-                // scl        \___
-                //
-
-                bus_control_next = 1'b1;
-                phy_state_next = PHY_STATE_ACTIVE;
-            end
-            PHY_STATE_WRITE_BIT_1: begin
-                // write bit
-                //      ________
-                // sda X________X
-                //        ____
-                // scl __/    \__
-
-                scl_o_next = 1'b1;
-                delay_scl_next = 1'b1;
-                delay_next = prescale << 1;
-                phy_state_next = PHY_STATE_WRITE_BIT_2;
-            end
-            PHY_STATE_WRITE_BIT_2: begin
-                // write bit
-                //      ________
-                // sda X________X
-                //        ____
-                // scl __/    \__
-
-                scl_o_next = 1'b0;
-                delay_next = prescale;
-                phy_state_next = PHY_STATE_WRITE_BIT_3;
-            end
-            PHY_STATE_WRITE_BIT_3: begin
-                // write bit
-                //      ________
-                // sda X________X
-                //        ____
-                // scl __/    \__
-
-                phy_state_next = PHY_STATE_ACTIVE;
